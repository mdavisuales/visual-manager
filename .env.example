# Neon: cadena de conexión "Pooled" (con -pooler en el host)
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon: cadena de conexión "Direct" (sin -pooler). Se usa para db:push
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar las sesiones. Genera una con:  openssl rand -base64 32
AUTH_SECRET=""

# URL pública del sitio (sin / al final). Se usa en los enlaces de los avisos de WhatsApp
NEXT_PUBLIC_SITE_URL="https://tu-sitio.netlify.app"

# Solo para crear el primer coordinador con: npm run db:seed (no hace falta en Netlify)
COORDINATOR_NAME="Nombre del coordinador"
COORDINATOR_EMAIL="coordinador@ejemplo.com"
COORDINATOR_PHONE="3001234567"
COORDINATOR_PASSWORD="cambia-esta-clave-123"

# ---- WhatsApp automático (Fase 4, OPCIONAL: sin esto funciona el modo manual gratuito) ----
# Se obtienen en developers.facebook.com (ver el README, sección "WhatsApp automático")
WHATSAPP_TOKEN=""                # token permanente (usuario del sistema)
WHATSAPP_PHONE_NUMBER_ID=""      # ID del número de teléfono
WHATSAPP_TEMPLATE_NAME=""        # nombre de la plantilla aprobada, por ejemplo: aviso_ministerio_visuales
WHATSAPP_TEMPLATE_LANG="es"      # idioma de la plantilla
WHATSAPP_APP_SECRET=""           # "Secreto de la app" de Meta, para validar el webhook
WHATSAPP_VERIFY_TOKEN=""         # una clave que inventas y repites al registrar el webhook
# WHATSAPP_API_VERSION="v25.0"   # solo si Meta retira esta versión

# Clave para la tarea programada (recordatorios y reintentos). Genera una con: openssl rand -base64 32
CRON_SECRET=""
